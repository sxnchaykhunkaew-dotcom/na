local function AddT(txt,k,cb)
    local f = cre("Frame",SF,{Size=UDim2.new(1,0,0,32),BackgroundColor3=Color3.fromRGB(30,30,30)}) ccn(f,5)
    cre("TextLabel",f,{Size=UDim2.new(0.7,0,1,0),Position=UDim2.new(0,8,0,0),Text=txt,TextColor3=Color3.fromRGB(255,255,255),Font=3,TextSize=13,BackgroundTransparency=1,TextXAlignment=0})
    local b = cre("TextButton",f,{Size=UDim2.new(0,55,0,22),Position=UDim2.new(1,-63,0.5,-11),BackgroundColor3=Color3.fromRGB(150,0,0),Text="OFF",TextColor3=Color3.fromRGB(255,255,255),Font=3,TextSize=11}) ccn(b,4)
    local function upd() b.BackgroundColor3=T[k] and Color3.fromRGB(0,150,0) or Color3.fromRGB(150,0,0) b.Text=T[k] and "ON" or "OFF" end
    b.MouseButton1Click:Connect(function() if k=="ShiftLock" then toggleSL() else T[k]=not T[k] if cb then cb(T[k]) end end upd() end)
    if k=="ShiftLock" then SLB.MouseButton1Click:Connect(upd) end
end

local function AddS(txt,mn,mx,df,k)
    local f = cre("Frame",SF,{Size=UDim2.new(1,0,0,40),BackgroundColor3=Color3.fromRGB(30,30,30)}) ccn(f,5)
    local l = cre("TextLabel",f,{Size=UDim2.new(0.9,0,0,18),Position=UDim2.new(0,8,0,2),Text=txt.." : "..df,TextColor3=Color3.fromRGB(255,255,255),Font=3,TextSize=12,BackgroundTransparency=1,TextXAlignment=0})
    local bg = cre("Frame",f,{Size=UDim2.new(1,-16,0,5),Position=UDim2.new(0,8,0.65,0),BackgroundColor3=Color3.fromRGB(60,60,60)})
    local fi = cre("Frame",bg,{Size=UDim2.new((df-mn)/(mx-mn),0,1,0),BackgroundColor3=Color3.fromRGB(255,255,255),BorderSizePixel=0})
    local dg = false local function u(inp) local pt = math.clamp((inp.Position.X-bg.AbsolutePosition.X)/bg.AbsoluteSize.X,0,1) fi.Size=UDim2.new(pt,0,1,0) local v=math.floor(mn+(mx-mn)*pt) l.Text=txt.." : "..v T[k]=v end
    bg.InputBegan:Connect(function(inp) if inp.UserInputType==Enum.UserInputType.MouseButton1 or inp.UserInputType==Enum.UserInputType.Touch then dg=true u(inp) end end)
    U.InputChanged:Connect(function(inp) if dg and (inp.UserInputType==Enum.UserInputType.MouseMovement or inp.UserInputType==Enum.UserInputType.Touch) then u(inp) end end)
    U.InputEnded:Connect(function(inp) if inp.UserInputType==Enum.UserInputType.MouseButton1 or inp.UserInputType==Enum.UserInputType.Touch then dg=false end end)
end

