local hue = 0

-- [ ระบบ Aimbot และ ESP แบบซ่อมแล้ว (ทำงานบน RenderStepped) ] --
R.RenderStepped:Connect(function()
    -- สีรุ้งเมนู
    hue = (hue + 0.002) % 1
    local color = Color3.fromHSV(hue, 0.7, 0.9)
    MF.BackgroundColor3 = color MB.BackgroundColor3 = color
    
    -- Aimbot 
    if T.Aimbot then
        local target = nil
        local dist = math.huge
        local center = Vector2.new(c.ViewportSize.X/2, c.ViewportSize.Y/2)
        for _, v in pairs(P:GetPlayers()) do
            if v ~= p and v.Character and v.Character:FindFirstChild("Head") and v.Character:FindFirstChild("Humanoid") and v.Character.Humanoid.Health > 0 then
                local pos, onScreen = c:WorldToViewportPoint(v.Character.Head.Position)
                if onScreen then
                    local mag = (Vector2.new(pos.X, pos.Y) - center).Magnitude
                    if mag < dist then dist = mag target = v.Character.Head end
                end
            end
        end
        if target then
            local smooth = math.clamp(T.AimbotSmooth / 10, 0.01, 1)
            c.CFrame = c.CFrame:Lerp(CFrame.new(c.CFrame.Position, target.Position), smooth)
        end
    end

    -- ESP & ShowHP
    for _, v in pairs(P:GetPlayers()) do
        if v ~= p and v.Character then
            if T.ESP then
                if not v.Character:FindFirstChild("NAMO_ESP") then
                    local hl = Instance.new("Highlight", v.Character)
                    hl.Name = "NAMO_ESP" hl.FillColor = Color3.fromRGB(255, 0, 50) hl.OutlineColor = Color3.fromRGB(255, 255, 255)
                end
            else
                if v.Character:FindFirstChild("NAMO_ESP") then v.Character.NAMO_ESP:Destroy() end
            end

            if T.ShowHP then
                if not v.Character:FindFirstChild("NAMO_HP") and v.Character:FindFirstChild("Head") then
                    local bg = Instance.new("BillboardGui", v.Character) bg.Name = "NAMO_HP" bg.Adornee = v.Character.Head bg.Size = UDim2.new(0, 100, 0, 30) bg.StudsOffset = Vector3.new(0, 2, 0) bg.AlwaysOnTop = true
                    local tl = Instance.new("TextLabel", bg) tl.Size = UDim2.new(1, 0, 1, 0) tl.BackgroundTransparency = 1 tl.TextColor3 = Color3.new(0, 255, 0) tl.TextScaled = true tl.Font = Enum.Font.SourceSansBold
                end
                if v.Character:FindFirstChild("NAMO_HP") and v.Character:FindFirstChildOfClass("Humanoid") then
                    v.Character.NAMO_HP.TextLabel.Text = "HP: " .. math.floor(v.Character:FindFirstChildOfClass("Humanoid").Health)
                end
            else
                if v.Character:FindFirstChild("NAMO_HP") then v.Character.NAMO_HP:Destroy() end
            end
        end
    end
end)

-- [ ระบบเคลื่อนไหวและชนกระเด็น (ทำงานบน Heartbeat) ] --
R.Heartbeat:Connect(function()
    local ch = p.Character if not ch then return end
    local r,h = ch:FindFirstChild("HumanoidRootPart"),ch:FindFirstChildOfClass("Humanoid") if not r or not h then return end
    
    if T.Spin then 
        local bav = r:FindFirstChild("S_Spin_BAV") or cre("BodyAngularVelocity",r,{Name="S_Spin_BAV",MaxTorque=Vector3.new(0,1e5,0),AngularVelocity=Vector3.new(0,T.SpinSpeed,0)}) 
        bav.AngularVelocity = Vector3.new(0,T.SpinSpeed,0) 
    else 
        if r:FindFirstChild("S_Spin_BAV") then r.S_Spin_BAV:Destroy() end 
    end

    -- ระบบชนกระเด็น Fling แท้ (ใช้ความเร็วการหมุนเหวี่ยง RootPart)
    if T.PushFling then
        r.RotVelocity = Vector3.new(0, T.PushForce, 0)
    end

    if T.Hitbox then 
        for _,o in pairs(P:GetPlayers()) do 
            if o ~= p and o.Character and o.Character:FindFirstChild("Head") then 
                local hd = o.Character.Head 
                if not OriginalSizes[o.Name] then OriginalSizes[o.Name] = hd.Size end 
                if hd.Size ~= Vector3.new(T.HitboxSize,T.HitboxSize,T.HitboxSize) then hd.Size = Vector3.new(T.HitboxSize,T.HitboxSize,T.HitboxSize) hd.Transparency = 0.6 hd.CanCollide = false hd.Massless = true end 
            end 
        end 
    else 
        for _,o in pairs(P:GetPlayers()) do 
            if o.Character and o.Character:FindFirstChild("Head") then 
                local hd = o.Character.Head 
                if OriginalSizes[o.Name] then hd.Size = OriginalSizes[o.Name] hd.Transparency = 0 hd.CanCollide = true hd.Massless = false OriginalSizes[o.Name] = nil end 
            end 
        end 
    end

    if T.Fly then 
        local bv = r:FindFirstChild("S_Fly_BV") or cre("BodyVelocity",r,{Name="S_Fly_BV",MaxForce=Vector3.new(1e5,1e5,1e5),Velocity=Vector3.new(0,0,0)}) 
        local bg = r:FindFirstChild("S_Fly_BG") or cre("BodyGyro",r,{Name="S_Fly_BG",MaxTorque=Vector3.new(1e5,1e5,1e5),CFrame=r.CFrame}) 
        if T.Spin then bg.MaxTorque = Vector3.new(1e5,0,1e5) else bg.MaxTorque = Vector3.new(1e5,1e5,1e5) end 
        h.PlatformStand = true local md = h.MoveDirection local camCF = c.CFrame local vel = Vector3.new(0,0,0) 
        if md.Magnitude > 0 then local lookVec = camCF.LookVector local rightVec = camCF.RightVector local camRelativeMove = camCF:VectorToObjectSpace(md) vel = vel + (lookVec * (-camRelativeMove.Z) * T.FlySpeed) vel = vel + (rightVec * camRelativeMove.X * T.FlySpeed) end 
        bv.Velocity = vel bg.CFrame = camCF 
    else 
        if r:FindFirstChild("S_Fly_BV") then r.S_Fly_BV:Destroy() end 
        if r:FindFirstChild("S_Fly_BG") then r.S_Fly_BG:Destroy() end 
        if h and h.PlatformStand then h.PlatformStand = false end 
    end

    if T.ShiftLock and not T.Fly and not T.Spin then local lv = c.CFrame.LookVector r.CFrame = CFrame.new(r.Position, Vector3.new(r.Position.X + lv.X, r.Position.Y, r.Position.Z + lv.Z)) end
    if T.Invis and p.Character then for _, o in pairs(p.Character:GetDescendants()) do if (o:IsA("BasePart") and o.Name ~= "HumanoidRootPart") or o:IsA("Decal") then o.Transparency = 1 end end end
    if T.AirWalk then if not ah then ah = r.Position.Y - 3.2 end if not ap or not ap.Parent then ap = cre("Part",workspace,{Size=Vector3.new(50,0.5,50),Anchored=true,Transparency=1}) end ap.CFrame = CFrame.new(r.Position.X,ah,r.Position.Z) end
    if T.Speed then h.WalkSpeed = T.WalkSpeed else if h.WalkSpeed ~= 16 and not T.Fly then h.WalkSpeed = 16 end end
    if T.Jump then h.UseJumpPower = true h.JumpPower = T.JumpPower else if h.JumpPower ~= 50 then h.JumpPower = 50 end end
    if T.DamageBoost and ch:FindFirstChildOfClass("Tool") then ch:FindFirstChildOfClass("Tool"):Activate() end
end)

